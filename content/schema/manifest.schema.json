{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tomlandia.game/schemas/content-manifest-v1.json",
  "title": "Tomlandia canonical content manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_version",
    "lifecycle",
    "spawn_set_version",
    "uuid_namespace",
    "tiers"
  ],
  "properties": {
    "schema_version": { "const": "tomlandia-content-manifest/v1" },
    "content_version": { "$ref": "#/$defs/versionId" },
    "lifecycle": { "enum": ["draft", "runtime"] },
    "spawn_set_version": { "$ref": "#/$defs/versionId" },
    "uuid_namespace": { "type": "string", "format": "uuid" },
    "tier_registry_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "tiers": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/tier" }
    },
    "id_inventory": { "$ref": "#/$defs/idInventory" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "test_fixture": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "lifecycle": { "const": "draft" } } },
      "then": {
        "required": ["tier_registry_version", "id_inventory"],
        "not": { "required": ["runtime"] }
      }
    },
    {
      "if": { "properties": { "lifecycle": { "const": "runtime" } } },
      "then": {
        "required": ["runtime"],
        "not": { "required": ["id_inventory"] },
        "properties": {
          "tiers": {
            "items": {
              "allOf": [
                { "$ref": "#/$defs/tier" },
                { "required": ["palette"] }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "contentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "versionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "colour": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000000
    },
    "tierPair": {
      "type": "object",
      "required": ["tier_index", "level_requirement"],
      "properties": {
        "tier_index": { "type": "integer", "minimum": 1, "maximum": 16 },
        "level_requirement": { "type": "integer", "minimum": 1, "maximum": 150 }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "accent"],
      "properties": {
        "primary": { "$ref": "#/$defs/colour" },
        "secondary": { "$ref": "#/$defs/colour" },
        "accent": { "$ref": "#/$defs/colour" }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier_index", "level_requirement", "theme"],
      "properties": {
        "tier_index": { "type": "integer", "minimum": 1, "maximum": 16 },
        "level_requirement": { "type": "integer", "minimum": 1, "maximum": 150 },
        "theme": { "type": "string", "minLength": 1 },
        "palette": { "$ref": "#/$defs/palette" }
      }
    },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/contentId" }
    },
    "idMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/idArray" }
    },
    "idInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_place_ids", "retired_ids", "new_ids", "sprite_kinds"],
      "properties": {
        "in_place_ids": { "$ref": "#/$defs/idMap" },
        "retired_ids": { "$ref": "#/$defs/idArray" },
        "new_ids": { "$ref": "#/$defs/idMap" },
        "sprite_kinds": { "$ref": "#/$defs/idArray" }
      }
    },
    "itemStats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attack", "defense", "heal", "speed", "dmg_boost", "boost_hits"],
      "properties": {
        "attack": { "type": "number", "minimum": 0 },
        "defense": { "type": "number", "minimum": 0 },
        "heal": { "type": "integer", "minimum": 0 },
        "speed": { "type": "number", "minimum": 0, "maximum": 0.25 },
        "dmg_boost": { "type": "number", "minimum": 0 },
        "boost_hits": { "type": "integer", "minimum": 0 }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "active", "tier_index", "level_requirement", "kind", "family",
        "colour", "rarity", "tradable", "stackable", "value", "stats"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "name": { "type": "string", "minLength": 1 },
        "active": { "type": "boolean" },
        "tier_index": { "type": "integer", "minimum": 1, "maximum": 16 },
        "level_requirement": { "type": "integer", "minimum": 1, "maximum": 150 },
        "kind": { "enum": ["resource", "material", "weapon", "armor", "food", "potion", "trophy"] },
        "family": { "$ref": "#/$defs/contentId" },
        "colour": { "$ref": "#/$defs/colour" },
        "rarity": { "enum": ["common", "uncommon", "rare", "epic", "legendary"] },
        "tradable": { "type": "boolean" },
        "stackable": { "type": "boolean" },
        "value": { "type": "integer", "minimum": 0 },
        "equip_skill": { "$ref": "#/$defs/contentId" },
        "stats": { "$ref": "#/$defs/itemStats" }
      }
    },
    "recipeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "qty"],
      "properties": {
        "item_id": { "$ref": "#/$defs/contentId" },
        "qty": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "active", "tier_index", "level_requirement", "station", "skill",
        "output_item_id", "output_qty", "xp", "time_s", "inputs"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "active": { "type": "boolean" },
        "tier_index": { "type": "integer", "minimum": 1, "maximum": 16 },
        "level_requirement": { "type": "integer", "minimum": 1, "maximum": 150 },
        "station": { "enum": ["smelt", "forge", "weave", "armor", "skin", "cook", "alchemy"] },
        "skill": { "$ref": "#/$defs/contentId" },
        "output_item_id": { "$ref": "#/$defs/contentId" },
        "output_qty": { "$ref": "#/$defs/positiveInteger" },
        "xp": { "type": "integer", "minimum": 0 },
        "time_s": { "type": "number", "exclusiveMinimum": 0 },
        "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/recipeInput" } }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "name", "active", "tier_index", "level_requirement", "skill", "item_id",
        "xp", "gather_s", "respawn_s", "max_charges", "family", "colour", "visual_key"
      ],
      "properties": {
        "kind": { "$ref": "#/$defs/contentId" },
        "name": { "type": "string", "minLength": 1 },
        "active": { "type": "boolean" },
        "tier_index": { "type": "integer", "minimum": 1, "maximum": 16 },
        "level_requirement": { "type": "integer", "minimum": 1, "maximum": 150 },
        "skill": { "$ref": "#/$defs/contentId" },
        "item_id": { "$ref": "#/$defs/contentId" },
        "xp": { "type": "integer", "minimum": 0 },
        "gather_s": { "type": "number", "exclusiveMinimum": 0 },
        "respawn_s": { "$ref": "#/$defs/positiveInteger" },
        "max_charges": { "$ref": "#/$defs/positiveInteger" },
        "family": { "$ref": "#/$defs/contentId" },
        "colour": { "$ref": "#/$defs/colour" },
        "visual_key": { "$ref": "#/$defs/contentId" }
      }
    },
    "loot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "chance", "qty_min", "qty_max", "channel", "xp"],
      "properties": {
        "item_id": { "$ref": "#/$defs/contentId" },
        "chance": { "type": "number", "minimum": 0, "maximum": 1 },
        "qty_min": { "$ref": "#/$defs/positiveInteger" },
        "qty_max": { "$ref": "#/$defs/positiveInteger" },
        "channel": { "enum": ["drop", "hide"] },
        "xp": { "type": "integer", "minimum": 0 }
      }
    },
    "monster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "name", "active", "tier_index", "level_requirement", "hp", "attack",
        "defense", "xp", "gold_min", "gold_max", "respawn_s", "visual_key", "loot"
      ],
      "properties": {
        "kind": { "$ref": "#/$defs/contentId" },
        "name": { "type": "string", "minLength": 1 },
        "active": { "type": "boolean" },
        "tier_index": { "type": "integer", "minimum": 1, "maximum": 16 },
        "level_requirement": { "type": "integer", "minimum": 1, "maximum": 150 },
        "hp": { "$ref": "#/$defs/positiveInteger" },
        "attack": { "type": "integer", "minimum": 0 },
        "defense": { "type": "integer", "minimum": 0 },
        "xp": { "type": "integer", "minimum": 0 },
        "gold_min": { "type": "integer", "minimum": 0 },
        "gold_max": { "type": "integer", "minimum": 0 },
        "respawn_s": { "$ref": "#/$defs/positiveInteger" },
        "visual_key": { "$ref": "#/$defs/contentId" },
        "loot": { "type": "array", "items": { "$ref": "#/$defs/loot" } }
      }
    },
    "weight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "weight"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 150 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "fish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "active", "tier_index", "level_requirement", "xp", "weights"],
      "properties": {
        "item_id": { "$ref": "#/$defs/contentId" },
        "active": { "type": "boolean" },
        "tier_index": { "type": "integer", "minimum": 1, "maximum": 16 },
        "level_requirement": { "type": "integer", "minimum": 1, "maximum": 150 },
        "xp": { "type": "integer", "minimum": 0 },
        "weights": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/weight" } }
      }
    },
    "fishingSpot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "active", "biome", "subzone", "x", "y", "fish_item_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "active": { "type": "boolean" },
        "biome": { "$ref": "#/$defs/contentId" },
        "subzone": { "$ref": "#/$defs/contentId" },
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "fish_item_ids": { "$ref": "#/$defs/idArray" }
      }
    },
    "itemReward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "qty"],
      "properties": {
        "item_id": { "$ref": "#/$defs/contentId" },
        "qty": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "quest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "active", "tier_index", "level_requirement", "kind", "target_id",
        "count", "gold", "xp_skill", "xp", "reward_items"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "name": { "type": "string", "minLength": 1 },
        "active": { "type": "boolean" },
        "tier_index": { "type": "integer", "minimum": 1, "maximum": 16 },
        "level_requirement": { "type": "integer", "minimum": 1, "maximum": 150 },
        "kind": { "enum": ["kill", "gather"] },
        "target_id": { "$ref": "#/$defs/contentId" },
        "count": { "$ref": "#/$defs/positiveInteger" },
        "gold": { "type": "integer", "minimum": 0 },
        "xp_skill": { "$ref": "#/$defs/contentId" },
        "xp": { "type": "integer", "minimum": 0 },
        "reward_items": { "type": "array", "items": { "$ref": "#/$defs/itemReward" } }
      }
    },
    "bossReward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "chance", "qty_min", "qty_max"],
      "properties": {
        "item_id": { "$ref": "#/$defs/contentId" },
        "chance": { "type": "number", "minimum": 0, "maximum": 1 },
        "qty_min": { "$ref": "#/$defs/positiveInteger" },
        "qty_max": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "boss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "active", "level_requirement", "hp", "attack", "defense",
        "respawn_s", "visual_key", "rewards"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/contentId" },
        "name": { "type": "string", "minLength": 1 },
        "active": { "type": "boolean" },
        "level_requirement": { "type": "integer", "minimum": 1, "maximum": 150 },
        "hp": { "$ref": "#/$defs/positiveInteger" },
        "attack": { "type": "integer", "minimum": 0 },
        "defense": { "type": "integer", "minimum": 0 },
        "respawn_s": { "$ref": "#/$defs/positiveInteger" },
        "visual_key": { "$ref": "#/$defs/contentId" },
        "rewards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/bossReward" } }
      }
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ordinal", "active", "biome", "subzone", "x", "y"],
      "properties": {
        "kind": { "$ref": "#/$defs/contentId" },
        "ordinal": { "type": "integer", "minimum": 0 },
        "active": { "type": "boolean" },
        "biome": { "$ref": "#/$defs/contentId" },
        "subzone": { "$ref": "#/$defs/contentId" },
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 }
      }
    },
    "migrationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_id", "action", "captured_value_required", "notice_key"],
      "properties": {
        "from_id": { "$ref": "#/$defs/contentId" },
        "action": { "enum": ["retain", "replace", "compensate", "stop"] },
        "to_id": { "$ref": "#/$defs/contentId" },
        "captured_value_required": { "type": "boolean" },
        "notice_key": { "$ref": "#/$defs/contentId" }
      }
    },
    "playerNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "details"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "details": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items", "recipes", "nodes", "monsters", "fish", "fishing_spots", "quests",
        "bosses", "node_spawns", "monster_spawns", "migration_rules", "player_notice"
      ],
      "properties": {
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "recipes": { "type": "array", "items": { "$ref": "#/$defs/recipe" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "monsters": { "type": "array", "items": { "$ref": "#/$defs/monster" } },
        "fish": { "type": "array", "items": { "$ref": "#/$defs/fish" } },
        "fishing_spots": { "type": "array", "items": { "$ref": "#/$defs/fishingSpot" } },
        "quests": { "type": "array", "items": { "$ref": "#/$defs/quest" } },
        "bosses": { "type": "array", "items": { "$ref": "#/$defs/boss" } },
        "node_spawns": { "type": "array", "items": { "$ref": "#/$defs/spawn" } },
        "monster_spawns": { "type": "array", "items": { "$ref": "#/$defs/spawn" } },
        "migration_rules": { "type": "array", "items": { "$ref": "#/$defs/migrationRule" } },
        "player_notice": { "$ref": "#/$defs/playerNotice" }
      }
    }
  }
}
