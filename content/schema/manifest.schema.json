    "itemReward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "qty"
      ],
      "properties": {
        "item_id": {
          "$ref": "#/$defs/contentId"
        },
        "qty": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "quest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "active",
        "tier_index",
        "level_requirement",
        "kind",
        "target_id",
        "count",
        "gold",
        "xp_skill",
        "xp",
        "reward_items"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contentId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "active": {
          "type": "boolean"
        },
        "tier_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "level_requirement": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "kind": {
          "enum": [
            "kill",
            "gather"
          ]
        },
        "target_id": {
          "$ref": "#/$defs/contentId"
        },
        "count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "gold": {
          "type": "integer",
          "minimum": 0
        },
        "xp_skill": {
          "$ref": "#/$defs/contentId"
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "reward_items": {
