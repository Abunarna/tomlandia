          "exclusiveMinimum": 0
        },
        "ground_offset_y": {
          "type": "number",
          "minimum": 0
        },
        "motion_profile": {
          "const": "static_front_facing_bob"
        },
        "fallback": {
          "$ref": "#/$defs/proceduralFallback"
        }
      }
    },
    "weight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "weight"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "fish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "active",
        "tier_index",
        "level_requirement",
        "xp",
        "weights"
      ],
      "properties": {
        "item_id": {
