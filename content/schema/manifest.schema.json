      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contentId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "active": {
          "type": "boolean"
        },
        "level_requirement": {
          "type": "integer",
          "minimum": 1,
