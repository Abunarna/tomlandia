{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tomlandia.game/schemas/content-manifest-v1.json",
  "title": "Tomlandia canonical content manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_version",
    "lifecycle",
    "spawn_set_version",
    "uuid_namespace",
    "tiers"
  ],
  "properties": {
    "schema_version": {
      "const": "tomlandia-content-manifest/v1"
    },
    "content_version": {
      "$ref": "#/$defs/versionId"
    },
    "lifecycle": {
      "enum": [
        "draft",
        "runtime"
      ]
    },
    "spawn_set_version": {
      "$ref": "#/$defs/versionId"
    },
    "uuid_namespace": {
      "type": "string",
      "format": "uuid"
    },
    "tier_registry_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "tiers": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/tier"
      }
    },
    "id_inventory": {
      "$ref": "#/$defs/idInventory"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "test_fixture": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "draft"
          }
        }
      },
      "then": {
        "required": [
          "tier_registry_version",
          "id_inventory"
        ],
        "not": {
          "required": [
            "runtime"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "runtime"
          }
        }
      },
      "then": {
        "required": [
          "runtime"
        ],
        "not": {
          "required": [
            "id_inventory"
          ]
        },
        "properties": {
          "tiers": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/tier"
                },
                {
                  "required": [
                    "palette"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "contentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "versionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "colour": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000000
    },
    "tierPair": {
      "type": "object",
      "required": [
        "tier_index",
        "level_requirement"
      ],
      "properties": {
        "tier_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "level_requirement": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        }
      }
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "secondary",
        "accent"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/colour"
        },
        "secondary": {
          "$ref": "#/$defs/colour"
        },
        "accent": {
          "$ref": "#/$defs/colour"
        }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier_index",
        "level_requirement",
        "theme"
      ],
      "properties": {
        "tier_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "level_requirement": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "palette": {
          "$ref": "#/$defs/palette"
        }
      }
    },
    "idArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/contentId"
      }
    },
    "idMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/idArray"
      }
    },
    "idInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_place_ids",
        "retired_ids",
        "new_ids",
        "sprite_kinds"
      ],
      "properties": {
        "in_place_ids": {
          "$ref": "#/$defs/idMap"
        },
        "retired_ids": {
          "$ref": "#/$defs/idArray"
        },
        "new_ids": {
          "$ref": "#/$defs/idMap"
        },
        "sprite_kinds": {
          "$ref": "#/$defs/idArray"
        }
      }
    },
    "itemStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attack",
        "defense",
        "heal",
        "speed",
        "dmg_boost",
        "boost_hits"
      ],
      "properties": {
        "attack": {
          "type": "number",
          "minimum": 0
        },
        "defense": {
          "type": "number",
          "minimum": 0
        },
        "heal": {
          "type": "integer",
          "minimum": 0
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25
        },
        "dmg_boost": {
          "type": "number",
          "minimum": 0
        },
        "boost_hits": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "active",
        "tier_index",
        "level_requirement",
        "kind",
        "family",
        "icon_key",
        "colour",
        "rarity",
        "tradable",
        "stackable",
        "value",
        "stats"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contentId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "active": {
          "type": "boolean"
        },
        "tier_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "level_requirement": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "kind": {
          "enum": [
            "resource",
            "material",
            "weapon",
            "armor",
            "food",
            "potion",
            "trophy"
          ]
        },
        "family": {
          "$ref": "#/$defs/contentId"
        },
        "icon_key": {
          "$ref": "#/$defs/contentId"
        },
        "colour": {
          "$ref": "#/$defs/colour"
        },
        "rarity": {
          "enum": [
            "common",
            "uncommon",
            "rare",
            "epic",
            "legendary"
          ]
        },
        "tradable": {
          "type": "boolean"
        },
        "stackable": {
          "type": "boolean"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        },
        "equip_skill": {
          "$ref": "#/$defs/contentId"
        },
        "stats": {
          "$ref": "#/$defs/itemStats"
        }
      }
    },
    "recipeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "qty"
      ],
      "properties": {
        "item_id": {
          "$ref": "#/$defs/contentId"
        },
        "qty": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "active",
        "tier_index",
        "level_requirement",
        "station",
        "skill",
        "output_item_id",
        "output_qty",
        "xp",
        "time_s",
        "inputs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/contentId"
        },
        "active": {
          "type": "boolean"
        },
        "tier_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "level_requirement": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "station": {
          "enum": [
            "smelt",
            "forge",
            "weave",
            "armor",
            "skin",
            "cook",
            "alchemy"
          ]
        },
        "skill": {
          "$ref": "#/$defs/contentId"
        },
        "output_item_id": {
          "$ref": "#/$defs/contentId"
        },
        "output_qty": {
          "$ref": "#/$defs/positiveInteger"
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "time_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/recipeInput"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "active",
        "tier_index",
        "level_requirement",
        "skill",
        "item_id",
        "xp",
        "gather_s",
        "respawn_s",
        "max_charges",
        "cluster_min",
        "shape",
        "family",
        "colour",
        "visual_key"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/contentId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "active": {
          "type": "boolean"
        },
        "tier_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "level_requirement": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "skill": {
          "$ref": "#/$defs/contentId"
        },
        "item_id": {
          "$ref": "#/$defs/contentId"
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "gather_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "respawn_s": {
          "$ref": "#/$defs/positiveInteger"
        },
        "max_charges": {
          "$ref": "#/$defs/positiveInteger"
        },
        "cluster_min": {
          "$ref": "#/$defs/positiveInteger"
        },
        "shape": {
          "enum": [
            "rock",
            "tree",
            "bush"
          ]
        },
        "family": {
          "$ref": "#/$defs/contentId"
        },
        "colour": {
          "$ref": "#/$defs/colour"
        },
        "visual_key": {
          "$ref": "#/$defs/contentId"
        }
      }
    },
    "loot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "chance",
        "qty_min",
        "qty_max",
        "channel",
        "xp"
      ],
      "properties": {
        "item_id": {
          "$ref": "#/$defs/contentId"
        },
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "qty_min": {
          "$ref": "#/$defs/positiveInteger"
        },
        "qty_max": {
          "$ref": "#/$defs/positiveInteger"
        },
        "channel": {
          "enum": [
            "drop",
            "hide"
          ]
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "monster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "active",
        "tier_index",
        "level_requirement",
        "hp",
        "attack",
        "defense",
        "xp",
        "gold_min",
        "gold_max",
        "respawn_s",
        "visual_key",
        "visual",
        "loot"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/contentId"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "active": {
          "type": "boolean"
        },
        "tier_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "level_requirement": {
          "type": "integer",
          "minimum": 1,
          "maximum": 150
        },
        "hp": {
          "$ref": "#/$defs/positiveInteger"
        },
        "attack": {
          "type": "integer",
          "minimum": 0
        },
        "defense": {
          "type": "integer",
          "minimum": 0
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "gold_min": {
          "type": "integer",
          "minimum": 0
        },
        "gold_max": {
          "type": "integer",
          "minimum": 0
        },
        "respawn_s": {
          "$ref": "#/$defs/positiveInteger"
        },
        "visual_key": {
          "$ref": "#/$defs/contentId"
        },
        "visual": {
          "$ref": "#/$defs/monsterVisual"
        },
        "loot": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/loot"
          }
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "properties": {
        "left": {
          "type": "number",
          "minimum": 0
        },
        "top": {
          "type": "number",
          "minimum": 0
        },
        "right": {
          "type": "number",
          "minimum": 0
        },
        "bottom": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "proceduralFallback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "accent",
        "size",
        "ears"
      ],
      "properties": {
        "body": {
          "$ref": "#/$defs/colour"
        },
        "accent": {
          "$ref": "#/$defs/colour"
        },
        "size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ears": {
          "enum": [
            "none",
            "beak",
            "horns",
            "spikes"
          ]
        }
      }
    },
    "monsterVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_key",
        "asset_path",
        "source_sha256",
        "padded_sha256",
        "canvas",
        "pivot",
        "visual_bounds",
        "click_bounds",
        "render_scale",
        "ground_offset_y",
        "motion_profile",
        "fallback"
      ],
